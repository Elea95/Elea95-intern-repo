    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/react-native": "^13.2.0",
    "@testing-library/user-event": "^14.6.1",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "react-test-renderer": "^18.3.1",
    "ts-jest": "^29.3.0"
  },
